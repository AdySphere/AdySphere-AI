{
  "name": "sales-sphere",
  "version": "0.1.0",
  "private": true,
  "description": "AdySphere lead-generation and outreach agent: finds prospects, writes emails in Adyasha's voice, saves Outlook drafts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@prisma/client": "^6.19.3",
    "commander": "^15.0.0",
    "country-to-currency": "^3.0.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "3.2"
  }
}
