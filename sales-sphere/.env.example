# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salessphere"
# Public URL of the app (used for the Microsoft OAuth redirect)
APP_URL="http://localhost:3000"
# Password for the web UI (HTTP basic auth, any username). Required in production.
APP_PASSWORD="change-me"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
# Shared secret for /api/cron/* endpoints (Railway/Vercel cron sends it as a Bearer token)
CRON_SECRET=""

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT="medium"
# Used only to estimate and log cost (USD per million tokens)
ANTHROPIC_INPUT_USD_PER_MTOK="4"
ANTHROPIC_OUTPUT_USD_PER_MTOK="20"

# --- Microsoft Graph (Entra ID app registration) ---
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# "organizations" for work accounts in any tenant, or your tenant id
MS_TENANT_ID="organizations"

# --- Apollo.io ---
APOLLO_API_KEY=""
# Set to "true" only if your Apollo plan includes organization search via API
APOLLO_ORG_SEARCH_ENABLED="false"

# --- Web search ---
# brave | none
SEARCH_PROVIDER="brave"
BRAVE_API_KEY=""

# --- Geocoding (Nominatim / OpenStreetMap, free) ---
# Nominatim's usage policy requires a real contact address in the User-Agent
NOMINATIM_CONTACT_EMAIL="mallicka@adysphere.com"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
